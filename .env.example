# Optional platform overrides. Keep real credentials outside the repository.
VLN_DATABASE_URL=postgresql+psycopg:///vln_pipeline
VLN_REDIS_URL=redis://127.0.0.1:6379/5
VLN_GPU_ID=0
VLN_CLOUD_POOLS_FILE=configs/cloud_pools.local.json
# Store the AK/SK pairs outside the repository; do not put them in job requests.
# Unset: use the current user's ~/.config/vln-pipeline/cloud.env.
# VLN_CLOUD_CREDENTIALS_FILE=/absolute/path/to/private/cloud.env
VLN_CLOUD_POLL_SECONDS=15
# VLN_RESOURCE_ROOT=/absolute/path/to/vln-pipeline
# Opt-in multi-user run output access; never grants access to credentials/runtime.
# VLN_SHARED_RUN_PERMISSIONS=false
# Optional read-only shared datasets, scene_datasets, action_tokenizer and render_assets.
# Unset: read inputs from VLN_RESOURCE_ROOT, preserving existing deployments.
# Runs (including _validation) remain under VLN_RESOURCE_ROOT/runs;
# indexes remain under VLN_RUNTIME_ROOT. A shared resource root is supported.
# VLN_SOURCE_ROOT=/absolute/path/to/shared/vln-pipeline
# Optional read-only RVQ bundle from an existing LightNav model deployment.
# Unset: use action_tokenizer under the configured source root.
# VLN_RVQ_BUNDLE_ROOT=/absolute/path/to/LightNav-0/action_tokenizer
# Existing Habitat and LeRobot runtimes are read-only; never install into them.
# VLN_HABITAT_PYTHON=/absolute/path/to/habitat/bin/python
# VLN_LEROBOT_PYTHON=/absolute/path/to/lerobot/bin/python
# VLN_NAVGEN_ENV=/absolute/path/to/private/seedance.env

# Optional existing VLNVerse USD scene directory
# VLN_VLNVERSE_SCENE_ROOT=/data/vlnverse_scenes

# Full verified VLNVerse scene mirror (requires ~312 GB before output reserve)
# VLN_VLNVERSE_MANAGED_SCENE_ROOT=/path/to/vlnverse/scenes
# VLN_ISAAC_PYTHON=/path/to/isaac/bin/python
# Existing per-connection LightNav serving endpoint; no model loaded in Celery workers.
# VLN_LIGHTNAV_ENDPOINT=ws://127.0.0.1:8051
# VLN_LIGHTNAV_MODEL_PROVENANCE=LightNav-0 deployment identity / checkpoint revision
# Optional JSON with checkpoint / action-tokenizer SHA256 hashes; frozen into each task.
# VLN_LIGHTNAV_MODEL_MANIFEST=/path/to/lightnav_model_provenance.json
