# Optional platform overrides. Keep real credentials outside the repository.
VLN_DATABASE_URL=postgresql+psycopg:///vln_pipeline
VLN_REDIS_URL=redis://127.0.0.1:6379/5
VLN_GPU_ID=0
# VLN_RESOURCE_ROOT=/absolute/path/to/vln-pipeline
# VLN_NAVGEN_ENV=/absolute/path/to/private/seedance.env

# Optional existing VLNVerse USD scene directory
# VLN_VLNVERSE_SCENE_ROOT=/data/vlnverse_scenes

# Full verified VLNVerse scene mirror (requires ~312 GB before output reserve)
# VLN_VLNVERSE_MANAGED_SCENE_ROOT=/path/to/vlnverse/scenes
# VLN_ISAAC_PYTHON=/path/to/isaac/bin/python
# Existing per-connection LightNav serving endpoint; no model loaded in Celery workers.
# VLN_LIGHTNAV_ENDPOINT=ws://127.0.0.1:8051
# VLN_LIGHTNAV_MODEL_PROVENANCE=LightNav-0 deployment identity / checkpoint revision
# Optional JSON with checkpoint / action-tokenizer SHA256 hashes; frozen into each task.
# VLN_LIGHTNAV_MODEL_MANIFEST=/path/to/lightnav_model_provenance.json
