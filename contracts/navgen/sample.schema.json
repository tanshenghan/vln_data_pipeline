{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/navgen/sample.schema.json",
  "title": "NavGen sample record",
  "type": "object",
  "required": ["sample_id", "status", "sample_spec", "quality"],
  "properties": {
    "sample_id": {"type": "string", "pattern": "^nav_[0-9]{6}(?:_[a-z0-9_-]+)?$"},
    "status": {"enum": ["accepted", "review", "rejected_pre_qc", "rejected_vlm", "rejected_trajectory"]},
    "effective_instruction": {"type": "string"},
    "pipeline_contract": {
      "type": ["object", "null"],
      "description": "Versioned stage contract used to produce this sample"
    },
    "prompt_report": {
      "type": ["object", "null"],
      "description": "Seedance prompt compiler/refiner audit output"
    },
    "usage": {
      "anyOf": [
        {"$ref": "#/$defs/usage"},
        {"type": "null"}
      ],
      "description": "Secret-free token, latency, video-duration and cost accounting"
    },
    "trajectory_report": {
      "type": ["object", "null"],
      "description": "Trajectory quality report with explicit provenance; route_contract is a plan prior, not ground truth.",
      "properties": {
        "source": {"type": "string"},
        "ground_truth": {"type": "boolean"},
        "metric_scale": {"type": "string"},
        "metric_units": {"type": "string"},
        "metrics_are_metric": {"type": "boolean"},
        "temporal_smoothing": {"type": "boolean"},
        "scale_anchor": {"type": "string"},
        "variant": {"type": ["string", "null"], "description": "Selected deterministic post-processing variant, e.g. smoothed_scaled."},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    },
    "trajectory_path": {"type": ["string", "null"]},
    "trajectory_data": {"type": ["string", "null"]},
    "planned_trajectory_path": {"type": ["string", "null"]},
    "quality": {
      "type": "object",
      "required": ["tier", "training_eligible"],
      "properties": {
        "tier": {"enum": ["A", "B", "reject"]},
        "training_eligible": {"type": "boolean"},
        "selection_rule": {"type": "string"}
      },
      "additionalProperties": true
    },
    "sample_spec": {
      "type": "object",
      "required": ["sample_id", "scene", "task", "route", "seedance_prompt", "seed"],
      "properties": {
        "sample_id": {"type": "string"},
        "seed": {"type": "integer", "minimum": 0},
        "seedance_prompt": {"type": "string", "minLength": 1},
        "scene": {"$ref": "#/$defs/scene"},
        "task": {"$ref": "#/$defs/task"},
        "route": {"$ref": "#/$defs/route"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "scene": {
      "type": "object",
      "required": ["scene_id", "room_type", "objects"],
      "properties": {
        "scene_id": {"type": "string"},
        "room_type": {"type": "string"},
        "semantic_label": {"type": "string", "description": "Observed semantic label; never inferred from room_type alone."},
        "semantic_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "semantic_source": {"type": "string", "description": "vlm, human, simulator, or another auditable source."},
        "objects": {"type": "array", "items": {"type": "object", "required": ["id", "category", "position", "size"]}},
        "regions": {
          "type": "array",
          "description": "Optional semantic room/area partitions. Empty means one open scene; consumers must not invent partitions.",
          "items": {
            "type": "object",
            "required": ["x_min", "x_max", "y_min", "y_max"],
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string"},
              "name": {"type": "string"},
              "x_min": {"type": "number"},
              "x_max": {"type": "number"},
              "y_min": {"type": "number"},
              "y_max": {"type": "number"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "task": {
      "type": "object",
      "required": ["type", "instruction_zh", "stop_condition"],
      "properties": {
        "type": {"enum": ["object_goal", "instruction_following", "target_tracking"]},
        "instruction_zh": {"type": "string", "minLength": 1},
        "stop_condition": {"type": "object"}
      },
      "additionalProperties": true
    },
    "route": {
      "type": "object",
      "required": ["waypoints", "expected_duration_s"],
      "properties": {
        "waypoints": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["t", "x", "y", "yaw"]}},
        "expected_duration_s": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": true
    },
    "usage": {
      "type": "object",
      "properties": {
        "request_count": {"type": "integer", "minimum": 0},
        "text_request_count": {"type": "integer", "minimum": 0},
        "video_request_count": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "video_provider_total_tokens": {"type": "integer", "minimum": 0},
        "video_requested_duration_s": {"type": "number", "minimum": 0},
        "video_actual_duration_s": {"type": "number", "minimum": 0},
        "latency_s": {"type": "number", "minimum": 0},
        "estimated_cost_cny": {"type": ["number", "null"], "minimum": 0},
        "billable_cost_cny": {"type": ["number", "null"], "minimum": 0},
        "cost_status": {"enum": ["configured", "estimated", "provider_reported", "partial", "unpriced", "not_applicable"]},
        "events": {"type": "array", "items": {"$ref": "#/$defs/usage_event"}}
      },
      "additionalProperties": true
    },
    "usage_event": {
      "type": "object",
      "required": ["kind", "stage", "latency_s", "cost_status"],
      "properties": {
        "kind": {"enum": ["text", "video"]},
        "stage": {"type": "string"},
        "latency_s": {"type": "number", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "provider_total_tokens": {"type": "integer", "minimum": 0},
        "requested_duration_s": {"type": ["number", "null"], "minimum": 0},
        "actual_duration_s": {"type": ["number", "null"], "minimum": 0},
        "cost_cny": {"type": ["number", "null"], "minimum": 0},
        "cost_status": {"enum": ["estimated", "provider_reported", "partial", "unpriced", "not_applicable"]}
      },
      "additionalProperties": true
    }
  }
}
